# Variables à définir dans Dokploy → onglet "Environment" (jamais dans le dépôt, jamais dans une image).
# Ce fichier ne documente QUE les noms : aucune valeur réelle. Les secrets se génèrent avec un gestionnaire de mots de passe.

# Domaine (assigne le domaine dans l'onglet Domains de Dokploy -> service web, port 3000)
DOMAIN=
# URL publique de l'app (facultatif) : liens dans les alertes Telegram ; acceptée aussi comme origine des requêtes (anti-CSRF)
APP_URL=

# Auth d'accès à l'app (page /login + repli HTTP Basic) - OBLIGATOIRE ; APP_PASSWORD : 14 caractères minimum, sinon l'accès est REFUSÉ (fail-closed)
APP_USER=
APP_PASSWORD=
# Secret de signature des cookies de session (FACULTATIF, 32 caractères minimum) ; sans lui, la clé est dérivée de APP_PASSWORD
# APP_SESSION_SECRET=
# Limitation des échecs d'authentification par adresse IP (facultatif) : 10 échecs -> blocage 15 min par défaut
# (plus un plafond global fixe : 50 échecs en 15 min, tous clients confondus -> blocage 15 min)
# AUTH_MAX_FAILURES=10
# AUTH_BLOCK_MINUTES=15

# MySQL (secrets)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=prospection
MYSQL_USER=prospection
MYSQL_PASSWORD=
# URL utilisée par web (Next.js) et worker (Python) - host = nom du service. Format : mysql://<MYSQL_USER>:<MYSQL_PASSWORD>@mysql:3306/<MYSQL_DATABASE>
DATABASE_URL=

# SearXNG (recherche du site officiel des entreprises)
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=

# Telegram (alertes des prospects « À contacter » + boutons de classement ⭐ 📞 🚫 ❌)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Identifiants des utilisateurs autorisés à utiliser les boutons (séparés par des virgules). Vide : toi seul en discussion
# directe, ou les administrateurs du canal configuré.
TELEGRAM_ALLOWED_USER_IDS=

LOG_LEVEL=INFO

# Prospection locale (facultatif)
# IMPORTANT : le planificateur du worker (worker/scheduler.py) ne transmet à ses tâches QUE les variables qui commencent par LOCAL_
# (plus DATABASE_URL, SEARXNG_URL, TELEGRAM_*, APP_URL, TZ, LOG_LEVEL, MIGRATIONS_DIR, PAGESPEED_API_KEY).
# Une clé nommée BRAVE_API_KEY ou SERPER_API_KEY (sans le préfixe) serait ignorée en silence.
# Le conteneur worker ne reçoit QUE les variables listées dans docker-compose.yml (service worker, bloc environment) :
# une NOUVELLE variable LOCAL_* doit aussi y être ajoutée.
# Guide pas à pas (clés, migration, vérification, suivi) : docs/GUIDE_CONNEXION.md
# LOCAL_LOOKUPS_PER_RUN=30           # entreprises dont le site est recherché à chaque passage (toutes les 15 min)
# LOCAL_TIME_BUDGET_S=600            # durée maximale d'un passage, en secondes
# LOCAL_AUDIT=1                      # 1 (défaut) = audit passif du site (SEO, technique, modernisation), y compris des sites déjà identifiés
#                                    # (10 par passage) ; 0 = on cherche seulement le site et un contact
# LOCAL_RECENT_SITE_YEAR=2024         # site dont la mention « © » est de cette année ou après : récent, entreprise écartée (même avec un e-mail)
# LOCAL_OSM=1                        # OpenStreetMap en complément (une requête par campagne) ; 0 pour désactiver
# LOCAL_OSM_URL=                     # vide = https://overpass-api.de/api/interpreter ; sinon l'adresse d'une instance Overpass dédiée
#
# Recherche du site officiel — PAR PALIERS (le palier suivant n'est utilisé que si AUCUN fournisseur du palier courant n'a pu répondre)
#   palier 0 : moteurs SearXNG (gratuits)  ->  palier 1 : API gratuites à quota (Brave, Tavily)  ->  palier 2 : PAYANT (Serper), en dernier recours
# Vérifier l'état réel : docker compose exec worker python -m worker.local.engines
#
# Palier 0 — SearXNG
# LOCAL_SEARCH_ENGINES=              # vide = moteurs actifs de SearXNG détectés automatiquement ; sinon liste séparée par des virgules (ex. brave,bing,qwant)
# LOCAL_ENGINE_DAILY_BUDGET=300      # requêtes par moteur SearXNG et par 24 h (on ménage les moteurs)
# LOCAL_ENGINE_INTERVAL_S=3          # délai minimal entre deux requêtes d'un même moteur (en dessous, certains moteurs répondent vide en silence)
#
# Palier 1 — API gratuites à quota (sans clé : palier ignoré) — secrets
# LOCAL_BRAVE_API_KEY=               # API officielle Brave Search (api-dashboard.search.brave.com) ; vérifier l'offre et le crédit mensuel sur le site
# LOCAL_BRAVE_DAILY_BUDGET=30        # requêtes Brave par 24 h (≈ 900 / mois) ; 0 = Brave désactivé même avec une clé
# LOCAL_TAVILY_API_KEY=              # API Tavily (tavily.com), facultative
# LOCAL_TAVILY_DAILY_BUDGET=30       # requêtes Tavily par 24 h ; 0 = Tavily désactivé
# LOCAL_TAVILY_MONTHLY_BUDGET=1000   # plafond mensuel Tavily (quota gratuit) ; 0 = pas de plafond mensuel
#
# Palier 2 — PAYANT, dernier recours (sans clé : aucune dépense possible) — secret
# LOCAL_SERPER_API_KEY=              # API Serper (serper.dev, résultats Google) — FACTURÉE au-delà des crédits offerts
# LOCAL_SERPER_DAILY_BUDGET=150      # requêtes Serper par 24 h ; 0 = Serper désactivé même avec une clé
# LOCAL_PAID_MONTHLY_BUDGET=0        # plafond MENSUEL cumulé des fournisseurs payants ; 0 = AUCUN plafond mensuel (seul le plafond quotidien s'applique)
# LOCAL_PAID_ON_EMPTY=0              # 1 = une réponse VIDE du gratuit fait aussi passer aux paliers suivants (plus de sites trouvés, plus de dépense)
#
# Google Places (New) — SOURCE de découverte des campagnes (chaque résultat rattaché à son entreprise SIRENE) et découverte du SITE d'un prospect « sans site » (le site est ensuite vérifié sur le site lui-même ; seul le place_id est conservé) — secret
# LOCAL_GOOGLE_PLACES_API_KEY=       # clé Google Cloud restreinte à « Places API (New) » ; sans clé : module inactif, aucun appel
# LOCAL_PLACES_BACKFILL_PER_RUN=1   # bouton « Interroger Google Places sur les fiches déjà trouvées » (page Statistiques) : fiches par passage d'enrichissement, 4 passages/h × 13 h ≈ 52/jour
# LOCAL_PLACES_SITE_CHECK_PER_RUN=5 # sites de fiche Google jamais vérifiés (URL perdue) : redemandés par Place Details (champ websiteUri seul, même budget),
#                                    # fiches par passage d'enrichissement (4/h, 8 h-20 h, sans moteur : pendant les campagnes aussi) ; 0 = désactivé
# LOCAL_GOOGLE_PLACES_DAILY_BUDGET=300     # quota QUOTIDIEN réglé chez Google (jour du Pacifique, compteur en base) : jamais dépassé, plus de 429 ; 0 = pas de plafond du jour
# LOCAL_PLACES_ENRICH_DAILY_RESERVE=60     # requêtes du jour que les campagnes laissent aux fiches existantes (au plus 1/5 du plafond du jour)
# LOCAL_PLACES_ENRICH_MONTHLY_RESERVE=300  # requêtes du mois que les campagnes laissent aux fiches existantes (au plus 1/5 du plafond du mois ; 3000/mois → 300)
# LOCAL_GOOGLE_PLACES_MONTHLY_BUDGET=900   # requêtes Text Search par mois (compteur en base) ; 0 = désactivé. Vérifier le quota gratuit actuel sur la page de tarification Google
#   (budget partagé par la découverte et la recherche de site ; pour ~3 000 requêtes/mois avec un crédit d'essai : 3000)
# LOCAL_PLACES_DISCOVERY_PER_RUN=20  # découverte des campagnes : pages Text Search au plus par passage (cron 15 min ; une requête commencée finit ses ≤ 3 pages) ; 0 = pas de découverte
# LOCAL_PLACES_MIN_POPULATION=500    # communes de la zone interrogées : au moins ce nombre d'habitants (la commune de la campagne toujours)
# PAGESPEED_API_KEY=                 # facultatif — secret
#
# Conservation des données (voir docs/SECURITE.md)
# LOCAL_RETENTION_MONTHS=18          # prospect jamais travaillé supprimé après N mois
# LOCAL_RETENTION_EXCLUDED_MONTHS=6  # prospect exclu supprimé après N mois
# LOCAL_RETENTION_WORKED_MONTHS=36   # prospect travaillé (hors « Gagné ») supprimé N mois après la dernière activité

# Envoi automatique des e-mails (DÉSACTIVÉ tant que Réglages > Envoi automatique n'est pas activé). Boîte d'envoi OVH :
# LOCAL_SMTP_HOST=                   # serveur SMTP (ex. pro2.mail.ovh.net pour E-mail Pro, ssl0.ovh.net pour MX Plan)
# LOCAL_SMTP_PORT=587                # 587 (STARTTLS) ou 465 (SSL)
# LOCAL_SMTP_USER=                   # l'adresse complète de la boîte
# LOCAL_SMTP_PASSWORD=               # mot de passe de la boîte (à saisir dans Dokploy, jamais dans Git)
# LOCAL_MAIL_FROM=                   # adresse d'expédition ; vide = LOCAL_SMTP_USER
# LOCAL_MAIL_FROM_NAME=              # nom affiché ; vide = le nom de Réglages > Signature
# LOCAL_IMAP_HOST=                   # lecture des réponses (IMAP 993, lecture seule) ; vide = LOCAL_SMTP_HOST
# LOCAL_IMAP_PORT=993
# LOCAL_DKIM_SELECTOR=               # sélecteur DKIM donné par OVH : la clé est vérifiée avant tout envoi
# LOCAL_EMAIL_SEARCH_PER_RUN=15      # prospects sans e-mail recherchés à nouveau par passage (deux fois par heure, 8 h-20 h) ; 0 = désactivé
# LOCAL_EMAIL_QUERIES_PER_PROSPECT=2 # requêtes par fiche et par essai (1 à 4), arrêt dès qu'une adresse attribuable est lue
# LOCAL_EMAIL_SEARCH_MIN_BUDGET_PCT=40 # la recherche d'e-mail s'arrête quand il reste moins de ce % du budget de 24 h des moteurs gratuits (gardé aux sites, revérifications, campagnes) ; 0 = pas de réserve
# LOCAL_EMAIL_RECHECK_MISS_DAYS=10   # nouvel essai quand rien n'a été trouvé
# LOCAL_EMAIL_RECHECK_DAYS=30        # nouvel essai quand une adresse a été trouvée
# LOCAL_SITE_RECHECK_PER_RUN=10      # prospects « sans site » (jamais contactés) dont le site est recherché une 2e fois, une seule fois chacun,
#                                    # au même passage (domaine de l'e-mail, nom + département…) ; 0 = désactivé
#
# Enrichissement des fiches existantes (worker/local/enrich.py, python -m worker.local.emailsearch) : passage complet à :20 et :50, sans moteur à :05 et :35
# (8 h-20 h). Les sous-passages sans moteur tournent même pendant une campagne ; ceux avec moteurs prennent le verrou des campagnes. État de chaque
# passage : page Statistiques (« Dernier passage d'enrichissement »).
# LOCAL_ENRICH_TIME_BUDGET_S=1200    # durée maximale d'un passage, attente du verrou comprise (passages complets toutes les 30 min)
# LOCAL_ENRICH_STEP_BUDGET_S=180     # durée maximale d'un sous-passage (aucun ne prive les autres)
# LOCAL_ENRICH_ENGINE_BUDGET_S=300   # temps passé sous le verrou des campagnes (une campagne attend au plus 6 min)
# LOCAL_ENRICH_LOCK_WAIT_S=600       # attente maximale du verrou des campagnes (une campagne en cours) avant de remettre les recherches au passage suivant
# LOCAL_ENGINE_ENRICH_RESERVE=40     # requêtes par moteur gratuit et par 24 h que les campagnes laissent à l'enrichissement (au plus 1/5 du budget du moteur)
# LOCAL_COMPANY_STATE_PER_RUN=40     # état officiel revérifié (SIRENE + BODACC, gratuits) : fermées / en procédure écartées ; 0 = désactivé
# LOCAL_SITE_GUESS_PER_RUN=20        # fiches sans site sûr : domaines devinés + domaine de l'e-mail, SANS moteur (une fois chacune) ; 0 = désactivé
# LOCAL_SITE_SEARCH_PER_RUN=3        # « sans site » après une recherche trop maigre : stratégies pas encore essayées (≈ 6 requêtes chacune) ; 0 = désactivé
# LOCAL_UNREACHABLE_RETRY_PER_RUN=5  # sites injoignables rouverts (3 jours d'écart, 2 fois au plus, puis « site en panne ») ; 0 = désactivé
# LOCAL_SITE_EMAIL_PER_RUN=10        # sites vérifiés sans e-mail : contact et mentions légales relus (relus ensuite après RETRY_DAYS) ; 0 = désactivé
# LOCAL_SITE_EMAIL_RETRY_DAYS=14     # délai avant de relire un site retenu toujours sans e-mail
# LOCAL_SITE_EMAIL_MAX_TRIES=3       # nombre maximal de lectures (la première comprise)
# LOCAL_STUCK_PER_RUN=10             # fiches « traitement en cours » hors campagne en cours : traitement fini (une reprise chacune) ; 0 = désactivé
# LOCAL_SITE_IDENTITY_PER_RUN=25    # sites déjà retenus relus avec la règle d'identité (SANS moteur, file d'envoi d'abord, une fois par version) ; 0 = désactivé
# LOCAL_SITE_SSL_STRICT=0           # 1 = un site lu en http:// dont le https:// a un certificat invalide (hébergeur, autre domaine) n'est pas exploitable ; 0 (défaut) = ignoré

# Purge automatique désactivée sans autorisation explicite (true).
RETENTION_ENABLED=false
