# Variables à définir dans Dokploy → onglet "Environment" (jamais dans le dépôt, jamais dans une image).
# Ce fichier ne documente QUE les noms : aucune valeur réelle. Les secrets se génèrent avec un gestionnaire de mots de passe.

# Domaine (assigne le domaine dans l'onglet Domains de Dokploy -> service web, port 3000)
DOMAIN=
# URL publique de l'app (facultatif) : liens dans les alertes Telegram ; acceptée aussi comme origine des requêtes (anti-CSRF)
APP_URL=

# Auth d'accès à l'app (page /login + repli HTTP Basic) - OBLIGATOIRE ; APP_PASSWORD : 14 caractères minimum, sinon l'accès est REFUSÉ (fail-closed)
APP_USER=
APP_PASSWORD=
# Secret de signature des cookies de session (FACULTATIF, 32 caractères minimum) ; sans lui, la clé est dérivée de APP_PASSWORD
# APP_SESSION_SECRET=
# Limitation des échecs d'authentification par adresse IP (facultatif) : 10 échecs -> blocage 15 min par défaut
# (plus un plafond global fixe : 50 échecs en 15 min, tous clients confondus -> blocage 15 min)
# AUTH_MAX_FAILURES=10
# AUTH_BLOCK_MINUTES=15

# MySQL (secrets)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=prospection
MYSQL_USER=prospection
MYSQL_PASSWORD=
# URL utilisée par web (Next.js) et worker (Python) - host = nom du service. Format : mysql://<MYSQL_USER>:<MYSQL_PASSWORD>@mysql:3306/<MYSQL_DATABASE>
DATABASE_URL=

# SearXNG (recherche du site officiel des entreprises)
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=

# Telegram (alertes des prospects « À contacter » + boutons de classement ⭐ 📞 🚫 ❌)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Identifiants des utilisateurs autorisés à utiliser les boutons (séparés par des virgules). Vide : toi seul en discussion
# directe, ou les administrateurs du canal configuré.
TELEGRAM_ALLOWED_USER_IDS=

LOG_LEVEL=INFO

# Prospection locale (facultatif)
# IMPORTANT : le planificateur du worker (worker/scheduler.py) ne transmet à ses tâches QUE les variables qui commencent par LOCAL_
# (plus DATABASE_URL, SEARXNG_URL, TELEGRAM_*, APP_URL, TZ, LOG_LEVEL, MIGRATIONS_DIR, PAGESPEED_API_KEY).
# Une clé nommée BRAVE_API_KEY ou SERPER_API_KEY (sans le préfixe) serait ignorée en silence.
# Le conteneur worker ne reçoit QUE les variables listées dans docker-compose.yml (service worker, bloc environment) :
# une NOUVELLE variable LOCAL_* doit aussi y être ajoutée.
# Guide pas à pas (clés, migration, vérification, suivi) : docs/GUIDE_CONNEXION.md
# LOCAL_LOOKUPS_PER_RUN=30           # entreprises dont le site est recherché à chaque passage (toutes les 15 min)
# LOCAL_TIME_BUDGET_S=600            # durée maximale d'un passage, en secondes
# LOCAL_AUDIT=0                      # 1 = audit passif du site (SEO, technique, modernisation). 0 (défaut) = on cherche seulement le site et un contact
# LOCAL_OSM=1                        # OpenStreetMap en complément (une requête par campagne) ; 0 pour désactiver
# LOCAL_OSM_URL=                     # vide = https://overpass-api.de/api/interpreter ; sinon l'adresse d'une instance Overpass dédiée
#
# Recherche du site officiel — PAR PALIERS (le palier suivant n'est utilisé que si AUCUN fournisseur du palier courant n'a pu répondre)
#   palier 0 : moteurs SearXNG (gratuits)  ->  palier 1 : API gratuites à quota (Brave, Tavily)  ->  palier 2 : PAYANT (Serper), en dernier recours
# Vérifier l'état réel : docker compose exec worker python -m worker.local.engines
#
# Palier 0 — SearXNG
# LOCAL_SEARCH_ENGINES=              # vide = moteurs actifs de SearXNG détectés automatiquement ; sinon liste séparée par des virgules (ex. brave,bing,qwant)
# LOCAL_ENGINE_DAILY_BUDGET=300      # requêtes par moteur SearXNG et par 24 h (on ménage les moteurs)
# LOCAL_ENGINE_INTERVAL_S=3          # délai minimal entre deux requêtes d'un même moteur (en dessous, certains moteurs répondent vide en silence)
#
# Palier 1 — API gratuites à quota (sans clé : palier ignoré) — secrets
# LOCAL_BRAVE_API_KEY=               # API officielle Brave Search (api-dashboard.search.brave.com) ; vérifier l'offre et le crédit mensuel sur le site
# LOCAL_BRAVE_DAILY_BUDGET=30        # requêtes Brave par 24 h (≈ 900 / mois) ; 0 = Brave désactivé même avec une clé
# LOCAL_TAVILY_API_KEY=              # API Tavily (tavily.com), facultative
# LOCAL_TAVILY_DAILY_BUDGET=30       # requêtes Tavily par 24 h ; 0 = Tavily désactivé
# LOCAL_TAVILY_MONTHLY_BUDGET=1000   # plafond mensuel Tavily (quota gratuit) ; 0 = pas de plafond mensuel
#
# Palier 2 — PAYANT, dernier recours (sans clé : aucune dépense possible) — secret
# LOCAL_SERPER_API_KEY=              # API Serper (serper.dev, résultats Google) — FACTURÉE au-delà des crédits offerts
# LOCAL_SERPER_DAILY_BUDGET=150      # requêtes Serper par 24 h ; 0 = Serper désactivé même avec une clé
# LOCAL_PAID_MONTHLY_BUDGET=0        # plafond MENSUEL cumulé des fournisseurs payants ; 0 = AUCUN plafond mensuel (seul le plafond quotidien s'applique)
# LOCAL_PAID_ON_EMPTY=0              # 1 = une réponse VIDE du gratuit fait aussi passer aux paliers suivants (plus de sites trouvés, plus de dépense)
# PAGESPEED_API_KEY=                 # facultatif — secret
#
# Conservation des données (voir docs/SECURITE.md)
# LOCAL_RETENTION_MONTHS=18          # prospect jamais travaillé supprimé après N mois
# LOCAL_RETENTION_EXCLUDED_MONTHS=6  # prospect exclu supprimé après N mois
# LOCAL_RETENTION_WORKED_MONTHS=36   # prospect travaillé (hors « Gagné ») supprimé N mois après la dernière activité

# Purge automatique désactivée sans autorisation explicite (true).
RETENTION_ENABLED=false
